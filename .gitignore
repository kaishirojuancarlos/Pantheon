# Pantheon Project Git Ignore Configuration
# ===========================================
#
# This file specifies intentionally untracked files that should be ignored
# by Git. It prevents build artifacts, IDE configuration files, and other
# generated or local files from being committed to the repository.
#
# For more information, see: https://git-scm.com/docs/gitignore

# -----------------------------------------------------------------------------
# Compiled and Generated Files
# -----------------------------------------------------------------------------

# Compiled class files
*.class

# -----------------------------------------------------------------------------
# Log Files
# -----------------------------------------------------------------------------

# Generic log files
*.log

# -----------------------------------------------------------------------------
# IDE-Specific Files
# -----------------------------------------------------------------------------

# BlueJ project files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# -----------------------------------------------------------------------------
# Build Artifacts and Distribution Files
# -----------------------------------------------------------------------------

# Java archive files
*.jar
*.war
*.nar
*.ear

# Archive files
*.zip
*.tar.gz
*.rar

# -----------------------------------------------------------------------------
# JVM Crash and Debug Files
# -----------------------------------------------------------------------------

# Virtual machine crash logs
# See: http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# -----------------------------------------------------------------------------
# Kotlin-Specific Files
# -----------------------------------------------------------------------------

# Kotlin Gradle plugin data
# See: https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/

# -----------------------------------------------------------------------------
# System and macOS Files
# -----------------------------------------------------------------------------

# Windows thumbnail database
Thumbs.db

# macOS metadata files
.DS_Store

# -----------------------------------------------------------------------------
# Gradle Build Files
# -----------------------------------------------------------------------------

# Gradle build cache and configuration
.gradle/

# Build output directories
build/

# -----------------------------------------------------------------------------
# Micronaut-Specific Files
# -----------------------------------------------------------------------------

# Micronaut build cache and generated files
.micronaut/

# -----------------------------------------------------------------------------
# IDE Configuration Files
# -----------------------------------------------------------------------------

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Eclipse
.project
.settings/
.classpath
.factorypath

# -----------------------------------------------------------------------------
# macOS and Xcode Files
# -----------------------------------------------------------------------------

# Xcode user data
xcuserdata

# Xcode external native build
.externalNativeBuild

# Xcode dependency files
.cxx/

# Xcode project files (ignore most, but allow specific files)
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata

# Xcode shared data
**/xcshareddata/WorkspaceSettings.xcsettings

# -----------------------------------------------------------------------------
# Node.js Files
# -----------------------------------------------------------------------------

# Node.js dependencies
node_modules/
